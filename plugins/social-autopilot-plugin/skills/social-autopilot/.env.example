# OpenAI-compatible LLM API (required for generate_posts.py)
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=
OPENAI_MODEL=moonshotai/kimi-k2.5

# Meta Graph API (optional; required for Facebook/Instagram publishing)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Xiaohongshu channel (optional)
# Leave empty when xiaohongshu-plugin is installed from this repo.
# Set only if you installed the CLI manually.
XHS_CLI_PATH=

# Runtime behavior
MAX_POSTS_PER_RUN=10
MIN_RELEVANCE_SCORE=0.6
DRY_RUN=false
LOG_LEVEL=INFO
