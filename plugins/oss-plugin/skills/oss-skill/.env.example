OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# Optional: public bucket or custom-domain base URL, without a trailing slash.
# When omitted, --url-mode auto returns a signed URL.
OSS_PUBLIC_BASE_URL=https://cdn.example.com
